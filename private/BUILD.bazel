"""Private build files for rules_flagd. Public surface lives in
//:defs.bzl, which re-exports from here."""

load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "flagd_test_trampoline.sh",
    "health_check.sh.tmpl",
    "launcher.py",
    "manifest.py",
    "run_cases.sh",
    "server.sh.tmpl",
    "testlib.py",
    "testlib.sh",
    "versions.bzl",
])

bzl_library(name = "providers", srcs = ["providers.bzl"])

bzl_library(name = "versions", srcs = ["versions.bzl"])

bzl_library(name = "repositories", srcs = ["repositories.bzl"], deps = [":versions"])

bzl_library(name = "flags", srcs = ["flags.bzl"], deps = [":providers"])

bzl_library(name = "server", srcs = ["server.bzl"], deps = [":flags", ":providers"])

bzl_library(name = "test", srcs = ["test.bzl"], deps = [":server"])

bzl_library(
    name = "install",
    srcs = ["install.bzl"],
    deps = [":flags", ":providers", ":versions", "@rules_kubectl//:defs"],
)
