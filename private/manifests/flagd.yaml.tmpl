# flagd for Kubernetes: rules_flagd's own manifest (there is no upstream
# standalone flagd chart). flagd_manifest fills in the markers at build
# time; objects carry no namespace, so `kubectl apply -n` places them.
apiVersion: v1
kind: ConfigMap
metadata:
  name: flagd-flags
  labels:
    app.kubernetes.io/name: flagd
    app.kubernetes.io/managed-by: rules_flagd
data:
__CONFIGMAP_DATA__
---
apiVersion: v1
kind: Service
metadata:
  name: flagd
  labels:
    app.kubernetes.io/name: flagd
    app.kubernetes.io/managed-by: rules_flagd
spec:
  selector:
    app.kubernetes.io/name: flagd
  ports:
    - name: evaluation
      port: 8013
      targetPort: evaluation
      appProtocol: kubernetes.io/h2c
    - name: management
      port: 8014
      targetPort: management
    - name: sync
      port: 8015
      targetPort: sync
      appProtocol: kubernetes.io/h2c
    - name: ofrep
      port: 8016
      targetPort: ofrep
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: flagd
  labels:
    app.kubernetes.io/name: flagd
    app.kubernetes.io/managed-by: rules_flagd
spec:
  replicas: __REPLICAS__
  selector:
    matchLabels:
      app.kubernetes.io/name: flagd
  template:
    metadata:
      labels:
        app.kubernetes.io/name: flagd
      annotations:
        # Changes with the flags, so re-applying new flags rolls the pods.
        rules-flagd/flags-sha256: "__FLAGS_SHA256__"
    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: flagd
          image: __IMAGE__
          args:
            - start
            - --log-format
            - json
__ARGS__
          ports:
            - name: evaluation
              containerPort: 8013
            - name: management
              containerPort: 8014
            - name: sync
              containerPort: 8015
            - name: ofrep
              containerPort: 8016
          readinessProbe:
            httpGet:
              path: /readyz
              port: management
            periodSeconds: 5
          livenessProbe:
            httpGet:
              path: /healthz
              port: management
            periodSeconds: 10
          resources:
            requests:
              cpu: 10m
              memory: 32Mi
            limits:
              memory: 128Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: flags
              mountPath: /etc/flagd
              readOnly: true
      volumes:
        - name: flags
          configMap:
            name: flagd-flags
