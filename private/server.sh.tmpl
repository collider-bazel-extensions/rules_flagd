#!/usr/bin/env bash
# flagd_server wrapper: resolves runfiles, execs the launcher.
# Substitution markers use __KEY__ syntax to avoid colliding with bash.
set -euo pipefail

if [[ -z "${RUNFILES_DIR:-}" ]]; then
  if [[ -n "${TEST_SRCDIR:-}" ]]; then RUNFILES_DIR="$TEST_SRCDIR"
  elif [[ -d "${0}.runfiles" ]]; then RUNFILES_DIR="${0}.runfiles"
  fi
  : "${RUNFILES_DIR:?flagd_server: no runfiles found; run it with bazel run / bazel test}"
  export RUNFILES_DIR
fi

resolve() {
  local p="$1"
  for c in "${RUNFILES_DIR}/_main/${p}" "${RUNFILES_DIR}/${p}" "${RUNFILES_DIR}/${p#../}"; do
    [[ -e "$c" ]] && { printf '%s\n' "$c"; return; }
  done
  echo "flagd_server: not in runfiles: ${p}" >&2
  exit 1
}

name='__NAME__'
tmp="${TEST_TMPDIR:-${TMPDIR:-/tmp}}"
# FLAGD_INSTANCE=<id> runs another replica of this target: its own ports,
# env file (<name>@<id>.env) and state directory.
if [[ -n "${FLAGD_INSTANCE:-}" ]]; then
  [[ "$FLAGD_INSTANCE" =~ ^[A-Za-z0-9_-]+$ ]] || {
    echo "flagd_server: FLAGD_INSTANCE='$FLAGD_INSTANCE': use letters, digits, _ and -" >&2; exit 1; }
  name="$name@$FLAGD_INSTANCE"
fi

# Resolve into variables first: a failing $(resolve) inside an argument
# list would not stop the script under `set -e`.
launcher="$(resolve '__LAUNCHER__')"
flagd="$(resolve '__FLAGD__')"
sources=()
__SOURCES__

exec python3 "$launcher" serve \
  --flagd "$flagd" \
  --env-file "$tmp/$name.env" \
  --state-dir "$tmp/flagd-$name" \
  --ready-timeout '__READY_TIMEOUT__' \
  ${sources[@]+"${sources[@]}"} \
  -- __EXTRA_ARGS__ "$@"
