{
  "context": {"region": "us"},
  "tests": [
    {"name": "staff get the new checkout",
     "flag": "new-checkout", "context": {"email": "dev@example.com"},
     "expect": {"value": true, "variant": "on", "reason": "TARGETING_MATCH"}},
    {"name": "everyone else gets the old checkout",
     "flag": "new-checkout", "context": {"email": "user@other.test"},
     "expect": {"value": false, "variant": "off"}},
    {"name": "overrides.yaml replaces base.json's color",
     "flag": "color",
     "expect": {"value": "#00ff00", "variant": "green", "reason": "STATIC"}},
    {"name": "gold tier gets the big discount",
     "flag": "discount", "context": {"tier": "gold"},
     "expect": {"value": 20, "variant": "big"}},
    {"name": "EU gets the small discount",
     "flag": "discount", "context": {"region": "eu"},
     "expect": {"value": 5}},
    {"name": "no rule matches: default variant",
     "flag": "discount",
     "expect": {"value": 0, "variant": "none", "reason": "DEFAULT"}},
    {"name": "object flag",
     "flag": "banner",
     "expect": {"value": {"text": "Welcome", "dismissible": true}}},
    {"name": "fractional rollout is sticky per targetingKey",
     "flag": "rollout", "context": {"targetingKey": "user-1"},
     "expect": {"reason": "TARGETING_MATCH"}},
    {"name": "disabled flag",
     "flag": "retired",
     "expect": {"reason": "DISABLED"}},
    {"name": "unknown flag",
     "flag": "no-such-flag",
     "expect": {"errorCode": "FLAG_NOT_FOUND"}}
  ]
}
