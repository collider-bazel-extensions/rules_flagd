load("@rules_flagd//:defs.bzl", "flagd_flags", "flagd_manifest", "flagd_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

flagd_flags(name = "flags", srcs = ["flags.json"])

flagd_test(
    name = "binary_test",
    srcs = ["binary_test.sh"],
    flags = [":flags"],
)

flagd_manifest(name = "manifest", flags = [":flags"])

sh_test(
    name = "image_test",
    srcs = ["image_test.sh"],
    args = ["$(rootpath :manifest)"],
    data = [":manifest"],
)

# v0.1's repo name, created because MODULE.bazel opts in.
sh_test(
    name = "v01_name_test",
    srcs = ["v01_name_test.sh"],
    args = ["$(rootpath @flagd_0_17_1_linux_amd64//:flagd_bin)"],
    data = ["@flagd_0_17_1_linux_amd64//:flagd_bin"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)
