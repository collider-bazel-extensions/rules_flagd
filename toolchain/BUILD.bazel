load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load(":toolchain.bzl", "current_flagd_toolchain", "flagd_toolchain")

package(default_visibility = ["//visibility:public"])

exports_files(["toolchain.bzl"])

toolchain_type(name = "flagd")

# The resolved flagd binary for the target platform, usable as `data`.
current_flagd_toolchain(name = "current")

# Per-platform toolchains. Each `flagd_<ver>_<plat>` repo (created by the
# module extension) ships the flagd binary for one platform.

flagd_toolchain(
    name      = "flagd_linux_amd64_impl",
    version   = "0.18.2",
    flagd_bin = "@flagd_0_18_2_linux_amd64//:flagd_bin",
)

toolchain(
    name                   = "flagd_linux_amd64",
    toolchain_type         = ":flagd",
    exec_compatible_with   = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    toolchain              = ":flagd_linux_amd64_impl",
)

flagd_toolchain(
    name      = "flagd_linux_arm64_impl",
    version   = "0.18.2",
    flagd_bin = "@flagd_0_18_2_linux_arm64//:flagd_bin",
)

toolchain(
    name                   = "flagd_linux_arm64",
    toolchain_type         = ":flagd",
    exec_compatible_with   = ["@platforms//os:linux", "@platforms//cpu:arm64"],
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:arm64"],
    toolchain              = ":flagd_linux_arm64_impl",
)

flagd_toolchain(
    name      = "flagd_darwin_amd64_impl",
    version   = "0.18.2",
    flagd_bin = "@flagd_0_18_2_darwin_amd64//:flagd_bin",
)

toolchain(
    name                   = "flagd_darwin_amd64",
    toolchain_type         = ":flagd",
    exec_compatible_with   = ["@platforms//os:osx", "@platforms//cpu:x86_64"],
    target_compatible_with = ["@platforms//os:osx", "@platforms//cpu:x86_64"],
    toolchain              = ":flagd_darwin_amd64_impl",
)

flagd_toolchain(
    name      = "flagd_darwin_arm64_impl",
    version   = "0.18.2",
    flagd_bin = "@flagd_0_18_2_darwin_arm64//:flagd_bin",
)

toolchain(
    name                   = "flagd_darwin_arm64",
    toolchain_type         = ":flagd",
    exec_compatible_with   = ["@platforms//os:osx", "@platforms//cpu:arm64"],
    target_compatible_with = ["@platforms//os:osx", "@platforms//cpu:arm64"],
    toolchain              = ":flagd_darwin_arm64_impl",
)

bzl_library(
    name = "toolchain",
    srcs = ["toolchain.bzl"],
    deps = ["//private:providers"],
)
